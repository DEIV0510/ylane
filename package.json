{
  "name": "ylane-perfumes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5331",
    "build": "next build",
    "start": "next start -p 5331",
    "lint": "next lint",
    "db:push": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs push --force",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "node scripts/reset-db.mjs && npm run db:push && npm run db:seed",
    "import:excel": "node scripts/import-excel.mjs",
    "test": "node --env-file-if-exists=.env.local scripts/verificar-catalogo.mjs",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "importar:proveedor": "node --env-file-if-exists=.env.local scripts/importar-proveedor.ts",
    "fotos:asignar": "node --env-file-if-exists=.env.local scripts/asignar-fotos.mjs",
    "verificar:fuga": "node --env-file-if-exists=.env.local scripts/verificar-fuga.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.44.6",
    "jose": "^6.1.0",
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
