# ─────────────────────────────────────────────────────────────
# YLANE PERFUMES — variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# BASE DE DATOS ------------------------------------------------
# Local (desarrollo): archivo SQLite
DATABASE_URL="file:./data/ylane.db"
# Producción (Turso / libSQL): libsql://<tu-base>.turso.io
DATABASE_AUTH_TOKEN=""

# SESIONES / ADMIN --------------------------------------------
# Secreto para firmar las cookies de sesión del panel.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Usuario administrador inicial (solo se usa al ejecutar `npm run db:seed`)
ADMIN_EMAIL="admin@ylaneperfumes.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador YLANE"

# SITIO --------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:5331"

# SUBIDA DE IMÁGENES ------------------------------------------
# Si defines un token de Vercel Blob, las imágenes del panel se guardan allí.
# Si lo dejas vacío, se guardan en /public/uploads (solo válido en local).
BLOB_READ_WRITE_TOKEN=""

# ANALÍTICA (opcional) ----------------------------------------
# Deja vacío mientras no tengas los IDs reales: no se carga nada.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# PASARELA DE PAGO (opcional, aún no activada) -----------------
# Proveedor: "" (desactivado) | "wompi" | "bold"
PAYMENTS_PROVIDER=""
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
NEXT_PUBLIC_BOLD_API_KEY=""
BOLD_SECRET_KEY=""
